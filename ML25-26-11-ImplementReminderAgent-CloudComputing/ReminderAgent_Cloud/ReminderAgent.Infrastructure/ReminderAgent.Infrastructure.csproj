  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReminderAgent.Common\ReminderAgent.Common.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
