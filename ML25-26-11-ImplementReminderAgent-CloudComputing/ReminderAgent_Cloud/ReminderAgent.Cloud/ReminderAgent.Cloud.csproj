<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Azure.Core" Version="1.61.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReminderAgent.Common\ReminderAgent.Common.csproj" />
    <ProjectReference Include="..\ReminderAgent.Infrastructure\ReminderAgent.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Plain Microsoft.NET.Sdk doesn't auto-copy appsettings*.json like Sdk.Web does. -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.dev.json" Condition="Exists('appsettings.dev.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
